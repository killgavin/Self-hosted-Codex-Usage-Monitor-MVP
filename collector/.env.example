# AES-128 key：32 個 Hex 字元。請自行產生，不要提交真實 Key。
CODEX_MONITOR_AES_KEY=REPLACE_WITH_32_HEX_CHARACTERS

# Google Drive 人工建立的固定 File ID。
CODEX_MONITOR_DRIVE_FILE_ID=REPLACE_WITH_FILE_ID

# Google OAuth 2.0 Desktop App credentials。
CODEX_MONITOR_GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID
CODEX_MONITOR_GOOGLE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# 可選設定
CODEX_MONITOR_GOOGLE_TOKEN_FILE=google-token.json
CODEX_MONITOR_CODEX_PATH=codex
