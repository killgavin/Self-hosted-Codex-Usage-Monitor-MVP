# AES-128 key：32 個 Hex 字元。請自行產生，不要提交真實 Key。\nCODEX_MONITOR_AES_KEY=00112233445566778899aabbccddeeff\n\n# Google Drive 人工建立的固定 File ID。\nCODEX_MONITOR_DRIVE_FILE_ID=REPLACE_WITH_FILE_ID\n\n# Google OAuth 2.0 Desktop App credentials。\nCODEX_MONITOR_GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID\nCODEX_MONITOR_GOOGLE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET\n\n# 可選設定\nCODEX_MONITOR_GOOGLE_TOKEN_FILE=google-token.json\nCODEX_MONITOR_CODEX_PATH=codex\n